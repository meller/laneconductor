{
  "environments": {
    "prod": { "command": "bash scripts/deploy.sh prod" },
    "staging": { "command": "bash scripts/deploy.sh staging" }
  },
  "components": {
    "frontend": "Firebase Hosting (landing)",
    "app": "Firebase Hosting (app)",
    "backend": "Firebase Cloud Functions (v2)",
