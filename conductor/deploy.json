{
  "defaultEnvironment": "production",
  "environments": {
    "production": {
      "command": "bash scripts/deploy-site.sh",
      "description": "The public site (landing/) on Firebase Hosting, project laneconductor-site, from a clean copy of main",
      "service": "laneconductor-site",
      "liveVersionUrl": "https://laneconductor-site.web.app/version.json",
      "liveVersionField": "version",
      "rollback": "bash scripts/deploy-site.sh {commit}"
    }
  }
}
