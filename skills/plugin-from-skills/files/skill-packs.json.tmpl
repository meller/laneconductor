{
  "marketplace": {
    "name": "{{marketplace-name}}",
    "source": "{{github-owner}}/{{github-repo}}",
    "owner": { "name": "{{your name}}" },
    "description": "{{one sentence: what the marketplace holds}}"
  },
  "plugin": {
    "author": { "name": "{{your name}}", "url": "https://github.com/{{github-owner}}" },
    "homepage": "{{homepage url}}",
    "repository": "https://github.com/{{github-owner}}/{{github-repo}}",
    "license": "{{license id, for example MIT}}",
    "privacyPolicyUrl": "{{url of a public privacy page}}"
  },
  "packs": [
    {
      "name": "{{marketplace-name}}-{{topic}}",
      "displayName": "{{Marketplace}} Skills: {{Topic}}",
      "description": "{{one sentence: what a person gets from this pack}}",
      "keywords": ["{{keyword}}"],
      "version": "0.1.0",
      "skills": ["{{skill-folder-name}}"]
    }
  ]
}
