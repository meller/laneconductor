/* Google Analytics 4 with consent (template). Replace {{MEASUREMENT_ID}} (G-...) and the notice text.
   Nothing is loaded from Google until the visitor accepts. Put this script at the end of <body>.
   Mark clickable things with data-track="event_name" and optional data-track-place="short_code". */
(function () {
  var ID = '{{MEASUREMENT_ID}}';
  var KEY = 'cookie_consent'; // 'true' accepted, 'false' declined, absent: not asked yet
  var started = false;
  if (!ID || ID.indexOf('{{') === 0) return;                 // no id: do nothing at all
  if (/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) return; // never in local development

  function choice() { try { return localStorage.getItem(KEY); } catch (e) { return null; } }
  function save(v) { try { localStorage.setItem(KEY, v); } catch (e) { /* storage blocked */ } }

  // Only short code-like values: numbers, booleans, strings up to 60 characters with no spaces and no @.
  function clean(p) {
    var out = {};
    Object.keys(p || {}).forEach(function (k) {
      var v = p[k];
      if (v === null || v === undefined) return;
      if (typeof v === 'number') { if (isFinite(v)) out[k] = Math.round(v * 100) / 100; return; }
      if (typeof v === 'boolean') { out[k] = v ? 1 : 0; return; }
      var s = String(v);
      if (s.length > 60 || s.indexOf('@') >= 0 || /\s/.test(s)) return;
      out[k] = s;
    });
    return out;
  }
  window.lcTrack = function (name, params) {              // a no-op until the tag has started
    if (!started || typeof window.gtag !== 'function') return;
    try { window.gtag('event', name, clean(params)); } catch (e) { /* analytics never breaks the page */ }
  };

  function start() {
    if (started) return;
    started = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); }; // Google's shape: push the arguments object
    window.gtag('js', new Date());
    window.gtag('config', ID, { allow_google_signals: false, allow_ad_personalization_signals: false });
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ID);
    document.head.appendChild(s);
  }

  function declined() { window['ga-disable-' + ID] = true; } // must be set before any gtag() call, on every page

  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
    if (el) window.lcTrack(el.getAttribute('data-track'), { place: el.getAttribute('data-track-place') });
  });

  var c = choice();
  if (c === 'true') return start();
  if (c === 'false') return declined();

  var bar = document.createElement('div');
  bar.setAttribute('role', 'dialog');
  bar.setAttribute('aria-label', 'Analytics');
  bar.style.cssText = 'position:fixed;left:16px;right:16px;bottom:16px;max-width:560px;margin:auto;padding:12px 16px;border-radius:10px;background:#111;color:#eee;font:14px/1.4 system-ui,sans-serif;display:flex;gap:12px;align-items:center;flex-wrap:wrap;z-index:9999';
  bar.innerHTML = '<span style="flex:1 1 220px">We count page views and a few clicks with Google Analytics, only if you allow it. No ads features.</span>';
  function button(label, yes) {
    var b = document.createElement('button');
    b.type = 'button'; b.textContent = label;
    b.style.cssText = 'font:inherit;padding:6px 12px;border-radius:6px;border:1px solid #888;background:' + (yes ? '#eee' : 'transparent') + ';color:' + (yes ? '#111' : '#eee') + ';cursor:pointer';
    b.addEventListener('click', function () { save(yes ? 'true' : 'false'); bar.remove(); if (yes) start(); else declined(); });
    return b;
  }
  bar.appendChild(button('Allow', true));
  bar.appendChild(button('No thanks', false));
  document.body.appendChild(bar);
})();
