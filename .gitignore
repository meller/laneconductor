# Dependencies
node_modules/
ui/node_modules/
cloud/node_modules/

# Environment & secrets — NEVER commit these
.env
.env.local
.env.*.local
ui/.env.remote
conductor/.env

# LaneConductor local config — machine-specific, contains DB credentials
.laneconductor.json

# Logs & runtime
*.log
/tmp/
conductor/.sync.pid
conductor/.sync.log
conductor/.sync*.lock-target
conductor/.sync-*.pid
# Per-worker machine tokens — credentials, one file per worker, never shared
conductor/.worker.tokens.json
conductor/.worker-*.tokens.json

# Git worktrees
.worktrees/

# Lock files — ephemeral machine-local state, not versioned
conductor/.locks/

# Track 10020: persistent per-track run markers (pid liveness for orphan
# reconciliation) — machine-local runtime state, not versioned
conductor/.runs/

# Found live 2026-09-07 (track 10076): per-track doc-sync merge-base cache
# (track 10073's design) — machine-local runtime state, not versioned. Left
# untracked and unignored, it shows up as "dirty" in every main-mode spawn's
# checkDirty() scan, which halts EVERY track's main-mode lane actions
# (including every merge) project-wide until someone notices and commits or
# ignores it — confirmed live, this blocked track 10076's done-lane merge.
conductor/.doc-sync/

# Runtime state — machine-specific, auto-generated
.conductor/
conductor/tracks-metadata.json
conductor/tracks-metadata.json.tmp-*
conductor/tracks.md
conductor/tracks/**/conversation.md
conductor/tracks/**/conversation.json

# Build output
ui/dist/
cloud/dist/
# Atlas CLI
atlas
atlas.exe
bin/atlas*
# Firebase project config (contains project ID — copy from .firebaserc.example)
.firebaserc
.firebase/
landing/.firebaserc
landing/.firebase/

# Editor
.DS_Store
.idea/
*.swp

/generated/

# Test artifacts
test-results/
playwright-report/

# Claude local settings
.claude/settings.local.json

# Third-party Claude skills — local-only, not distributed with this project
# Only the laneconductor skill itself is tracked (it's the product)
.claude/skills/*/
!.claude/skills/laneconductor/

# Track AM-10096: a nested .claude/.claude must never be committable, at any
# depth. The rules above are root-anchored and do not reach a nested path,
# which is exactly how a worktree-creation bug (see
# conductor/services/claude-dir-copy.mjs) let 480 otherwise-ignored files
# ride onto main across five nesting levels — an agent's ordinary `git add`
# inside a worktree swept each new level in. This is defense in depth behind
# that fix, not a substitute for it, and does not untrack what commit
# fix(track-10096) already removed.
**/.claude/.claude/

# Antigravity local skills
.agents/skills/


# PID files
ui/.ui.pid
ui/.api.pid
.ui.pid
.api.pid
.logs.pid
.logs.log
.pinorama.msp

# Guard against re-adding debug scripts
tmp_*.mjs
check_*.mjs
fix_*.mjs
reset_*.mjs
# Test fixture directories live inside the repo (no isolated .git of their
# own) - a wildcard here, not per-test literal entries, is what actually
# matters: spawnCli's exit handler unconditionally `git add`/`git commit`s
# a completed track's index.md against whatever repo contains its cwd, and
# `git add` on a gitignored path is the only thing stopping that from
# landing test artifacts on this repo's real history (see commits
# 4b94333/b621b9d - a test that let a track run to success without this
# wildcard in place did exactly that).
.test-tmp-*
.test-worker-mode-*
.conv-cursor
# Scratch files with potential secrets
scratch/*.cjs
scratch/check_prod_*.* 
scratch/delete_prod_*.* 
